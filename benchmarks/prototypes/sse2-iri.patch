+// Research prototype: skip only blocks proven to contain ordinary ASCII IRI
+// bytes. The original scanner handles every delimiter, escape, Unicode byte,
+// error and short tail. SSE2 is a baseline requirement of x86_64.
+#[inline]
+fn ascii_iri_prefix(bytes: &[u8]) -> usize {
+    #[cfg(target_arch = "x86_64")]
+    {
+        use std::arch::x86_64::*;
+        let mut position = 0;
+        // SAFETY: each unaligned 16-byte load is guarded by a length check.
+        // SSE2 is mandatory on x86_64. No load crosses the input slice's end.
+        unsafe {
+            while bytes.len() - position >= 16 {
+                let lanes = _mm_loadu_si128(bytes.as_ptr().add(position).cast());
+                // Signed compare also marks non-ASCII bytes for scalar handling.
+                let mut special = _mm_cmpgt_epi8(_mm_set1_epi8(33), lanes);
+                for byte in *b"\"<>\\^`{|}" {
+                    special =
+                        _mm_or_si128(special, _mm_cmpeq_epi8(lanes, _mm_set1_epi8(byte as i8)));
+                }
+                let mask = _mm_movemask_epi8(special) as u32;
+                if mask != 0 {
+                    return position + mask.trailing_zeros() as usize;
+                }
+                position += 16;
+            }
+        }
+        position
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    {
+        let _ = bytes;
+        0
+    }
+}
